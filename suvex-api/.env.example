# Suvex API 环境配置模板
#
# 用法：cp .env.example .env 然后按需修改。
# ⚠️ .env 已在 .gitignore 里，真实凭据不要提交。
#
# 这里的值是**开发态默认值**，刻意与 docker-compose.yml 里的一致，
# 让「本机直接跑」和「compose 起容器」两种方式的配置看起来一样。

# ── 运行环境 ──────────────────────────────────────────────
# dev | prod。prod 会强制打开 Cookie 的 Secure 属性（见 COOKIE_SECURE）
SUPEX_ENV=dev
# 日志级别：debug | info | warning | error
SUPEX_LOG_LEVEL=info

# ── 数据库 ────────────────────────────────────────────────
# 驱动固定用 psycopg 3（postgresql+psycopg://）。
# 本机直跑时宿主端口是 55432（见 README 的 PostgreSQL 一节）；
# 容器里跑时主机名是服务名 db、端口是标准的 5432 —— compose 会覆盖这一项。
SUPEX_DATABASE_URL=postgresql+psycopg://suvex:suvex_dev_local@127.0.0.1:55432/suvex

# ── 凭据加密（provider 的 API key）────────────────────────
# ★ 这一条密钥必须自己生成，**不要照抄任何示例值**。
#
#     python -m app.core.crypto
#
# 它只用于加密 provider 的 API key，不参与签名、不派生会话 ——
# 一条密钥只承担一个职责，泄漏时影响面才是可界定的。
#
# ⚠️⚠️ 必须和数据库一起备份。丢了它（或换一条），
#       已存的 provider 凭据就全部解不开，只能重新填写。
#       生产环境（SUPEX_ENV=prod）缺少它是启动**硬错误**。
SUPEX_SECRET_KEY=

# ── LLM 连通性探测（POST /providers/{id}/verify）──────────
# 探测会真的发一次请求，所以必须有超时。
SUPEX_LLM_PROBE_TIMEOUT_SECONDS=20
# 输出上限：只问一句话，答案限制在几个 token，验证的是凭据而非模型能力。
# 探测的 output 上限。**别调回个位数** —— 推理型模型会把预算全用在
# reasoning 上，content 永远是空的（详见 app/core/config.py 的说明）。
SUPEX_LLM_PROBE_MAX_TOKENS=256
# 是否允许 baseUrl 指向内网/回环地址。**默认允许** ——
# 本地模型（Ollama 在 127.0.0.1:11434）是明确支持的一类，
# 置 false 会让它完全不可用。云厂商元数据地址无论此项如何都会被拦。
SUPEX_ALLOW_PRIVATE_LLM_ENDPOINTS=true

# ── 会话 Cookie ───────────────────────────────────────────
SUPEX_SESSION_COOKIE_NAME=suvex_session
# 会话有效期（小时）。契约 §1.2 定的是 12 小时。
SUPEX_SESSION_TTL_HOURS=12
# 开发态是 http，必须 false；生产走 https 时设 true。
# ⚠️ 生产环境忘记打开它 = 会话在明文信道上传输。
SUPEX_COOKIE_SECURE=false

# ── CORS ──────────────────────────────────────────────────
# 带凭据的跨源请求**不能用 `*`** —— 浏览器会直接拒绝。
# 所以这里必须逐个列出具体源，逗号分隔。
# 开发态前端在 5173，后端在 8000，是跨源；少了这里的配置会出现
# 「登录成功但下一个请求又是未登录」。
SUPEX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 高风险：扫描授权声明（契约 §5）────────────────────────
# 服务端按这个字符串**逐字校验**前端送来的 statement。
# 改这里等于改用户同意的那句话 —— 前后端必须同步改，否则扫描建不出来。
SUPEX_SCAN_AUTHORIZATION_STATEMENT=我有权对此目标进行安全测试

# ── 疑似卡死检测（契约 §2.1，v0.17）───────────────────────
#
# 扫描**多久没有任何新活动事件**就标记为「疑似卡死」。
#
# 起因是一次真实事故：一次扫描跑了 32 分 16 秒零产出，而界面从头到尾
# 只是一个转圈的图标 —— 用户既不知道还该不该等，也不知道哪里出了问题。
# 判据用**事件时间戳**而不是 CPU：agent 在跑一条不返回的长命令时 CPU
# 可能很高，而它确实卡住了；反过来"在跑长命令但暂时无输出"是正常的。
#
# 0 = 关掉检测（不建议，等于把这次事故的教训丢掉）。
# 600（10 分钟）是默认值：真扫描偶尔会有几分钟安静期，阈值太短会误报，
# 而误报的代价是用户从此忽略这个提示。
SUPEX_SCAN_STALL_SECONDS=600

# 检测到卡死之后做什么：
#   flag = **只标记**（默认）。在列表里显示「疑似卡死 · 已静默 N 分钟」，
#          由用户决定继续等还是终止它。
#   abort = 自动终止这次扫描。
#
# ⚠️ 默认是 flag 而不是 abort：这是个**启发式**判断，而终止一个正在跑
#    真扫描的进程不可逆 —— 一次误判会白毁掉一次可能马上就出结果的扫描。
#    只在你有明确的运维需要（比如节点要回收）时才改成 abort。
SUPEX_SCAN_STALL_ACTION=flag

# ── 漏洞附件（契约 §3.15，v0.18）──────────────────────────
#
# 用户上传的处置证据（修复前后截图、复测报告、抓包）落在哪里。
# 空 = `<项目根>/_uploads`。
#
# ⚠️ 必须与 `SUPEX_SCAN_WORK_ROOT` 是**两个目录**：扫描产物会被保留期
#    清理掉（sweep_retention 按扫描工作目录删），而附件的生命周期
#    跟着漏洞走 —— 混在一起会让"清一次回收站"顺手删掉证据。
#
# ⚠️ 这个目录**绝不要提交进 git**（.gitignore 已排除 `_uploads/`）：
#    附件是业务数据，可能含内网截图与抓包里的凭据。
SUPEX_ATTACHMENT_ROOT=

# 单个附件的字节上限。默认 10 MiB。
#
# 没有上限的话，一个 2 GB 的上传就能把磁盘写满 —— 而磁盘满是
# **整个服务**不可用，不只是那个请求失败。
SUPEX_ATTACHMENT_MAX_BYTES=10485760

# 一次请求内允许的附件数量上限，防止"一次传 500 个"占满磁盘与请求时间。
SUPEX_ATTACHMENT_MAX_COUNT=20

# ── 登录限流（契约 §3.1）──────────────────────────────────
# 口令是本系统唯一的凭据，不限流等于允许在线爆破。
SUPEX_LOGIN_LIMIT_PER_MINUTE=5
SUPEX_LOGIN_LIMIT_PER_HOUR=15

# ── SSE（契约 §4）─────────────────────────────────────────
# 心跳间隔（秒）。15–30 之间，太短是噪音，太长会被中间代理断连。
SUPEX_SSE_HEARTBEAT_SECONDS=20
# 单个连接最多补发多少条历史事件；超出则发 resync 帧让客户端重新拉取。
SUPEX_SSE_REPLAY_MAX_EVENTS=1000
