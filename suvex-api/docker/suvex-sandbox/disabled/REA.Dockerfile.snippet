# ============================================================
# 已停用的 Dockerfile 片段：REA 逆向工具（2026-10-27 移出构建路径）
#
# 为什么移出：体积决策。REA + node 净增约 290 MB，而它拿不到反编译
# （无 Ghidra/Hopper/IDA 时 `rea inspect` 直接 provider_unavailable）。
# 用户当时的选择是「先不装 REA」。
#
# 要重新启用：把下面整段贴回 Dockerfile 中 hurl 段之前，并同时恢复
#   app/kernel/runner.py 的 TOOL_NAMES 里的 "rea" 与 dispatch 分支，
#   以及 app/kernel/tools.py 里的 ToolSpec(name="rea", ...)。
# ============================================================

# ── ★ REA 逆向工具（2026-10-27 补）────────────────────────────────────
#
# ## 装它干什么
#
# REA（https://github.com/morluto/rea，MIT）补上「静态逆向」这一侧：
# ELF/PE 结构、Go/Rust 构建元数据、APK 签名、asar/zip 归档图、前端
# bundle 的静态调用图、SQLite 表结构、Dart AOT、.NET 元数据。
# 与已有的 `browser`（动态跑页面）和 `nmap`/`httpx`（网络扫描）不重叠。
#
# ## ★ 为什么不挂成 MCP 连接（这是本段最重要的决定）
#
# REA 本体是个 MCP server。实测 `tools/list` 返回 **229 个工具 / 4.2 MB**，
# 而内核 `app/kernel/mcp.py:87 MAX_DESCRIBE_CHARS = 24_000` 只够覆盖
# **4 个（1%）**。挂进来等于：界面上列着 229 个工具，模型只知道 4 个，
# 剩下 225 个存在但对模型完全不可见 —— 正是我们反复清理的那种「假工具」。
#
# 所以走 `app/kernel/rea.py` 的封装：模型只需要知道 1 个工具名 `rea`
# 加一批子命令名。白名单只放**实测在没有反编译引擎的环境里真能出结果**
# 的命令（43 个；GHIDRA/HOPPER/IDA 那族一条都没放）。
#
# ## ⚠️ node 必须装，而 agent-browser 那段刻意不装
#
# 上面 agent-browser 是 Bun 编成的独立 ELF，`env -i` 也能跑，所以那段
# 不装 node。REA 不是：它的 bin 指向 `scripts/rea.mjs`（ESM 脚本），
# 靠 `#!/usr/bin/env node` 启动，`engines.node` 要求
# `^22.23.4 || ^24.22.1 || >=26.12.1`。
#
# 坑（实测）：Kali 源的 nodejs 最高到 24.21.0，**不满足 >=24.22.1**；
# 而 `npm install` 只警告不阻断，装完 `rea doctor` 才报 `node ok:false`。
# 所以这里从 nodejs.org 取官方 tarball 钉 v24.22.1。
#
# ## 体积（2026-10-27 实测，Kali 虚拟机只有 12 GB 可用）
#
#   node v24.22.1 官方 tarball 全解   ≈ 458 MB
#     其中可删：include/node 67MB（C++ 头文件，纯运行时用不到）
#               lib/node_modules/npm + corepack 269MB（我们只 `node xxx.mjs`，
#               构建期用它装依赖，装完就删）
#     → 只留 bin/node ≈ 122 MB
#   REA 本体 + 运行期依赖            ≈ 166 MB
#     其中可删：@anthropic-ai（REA 自带的 agent SDK，我们用 CLI，用不到）
#
#   → 本段净增约 **+290 MB**（不含构建期的临时占用）
#
# ## ⚠️ 依赖装完就删 node_modules 里的 dev 与 optional
#
# `frida` 是 optionalDependency，113 MB。REA 里用到它的只有
# `instrument-with-frida` 那一族 —— 那族需要一个装了 frida-server 的
# 真机/模拟器，容器里用不上。`--omit=optional` 省掉。
ARG NODE_VERSION=v24.22.1
ARG REA_VERSION=6.8.0
#: rea-agents tarball 的 sha256（2026-10-27 从 registry.npmmirror.com 取，
#: 与 npm 公布的同版本同字节）。钉死是为了「上游重发 tarball」时构建
#: 直接失败，而不是悄悄装进一份不同的代码。
ARG REA_SHA256=8d542ec76a9cb350584b60a6c9c088706ff812d5bb5b094c20c95b6dc25698bb

RUN set -eux; \
    test "$(dpkg --print-architecture)" = "amd64" \
      || { echo "REA 段只处理 amd64（node 官方 tarball 需对应架构）" >&2; exit 1; }; \
    cd /tmp; \
    TGZ=node-$NODE_VERSION-linux-x64.tar.xz; \
    curl -fsSL -o "$TGZ" "https://nodejs.org/dist/$NODE_VERSION/$TGZ"; \
    curl -fsSL -o SHASUMS256.txt "https://nodejs.org/dist/$NODE_VERSION/SHASUMS256.txt"; \
    # 对官方 SHASUMS 校验，而不是硬编码。硬编码数字在 node 重发
    # tarball 时会失败；对 SHASUMS 至少能和官方那一份对账。
    EXPECTED=$(grep " $TGZ\$" SHASUMS256.txt | awk '{print $1}'); \
    ACTUAL=$(sha256sum "$TGZ" | awk '{print $1}'); \
    test -n "$EXPECTED" || { echo "SHASUMS 里没有 $TGZ" >&2; exit 1; }; \
    test "$EXPECTED" = "$ACTUAL" \
      || { echo "node sha256 不匹配 expected=$EXPECTED actual=$ACTUAL" >&2; exit 1; }; \
    tar -xJf "$TGZ" -C /usr/local --strip-components=1; \
    rm -f "$TGZ" SHASUMS256.txt; \
    # ★ 构建期自检：版本必须真的达标的。`npm install` 对 engines 只警告，
    #   所以这里自己判一次 —— 否则会装出一个 `doctor` 永远红的环境。
    node --version; \
    node -e 'const [a,b,c]=process.versions.node.split(".").map(Number); \
      const ok = (a>26) || (a===26 && (b>12 || (b===12 && c>=1))) \
              || (a===24 && (b>22 || (b===22 && c>=1))) \
              || (a===22 && (b>23 || (b===23 && c>=4))); \
      if (!ok) { console.error("node "+process.versions.node+" 不满足 REA 的 engines 要求"); process.exit(1); }'

RUN set -eux; \
    cd /tmp; \
    curl -fsSL -o rea.tgz \
      "https://registry.npmmirror.com/rea-agents/-/rea-agents-$REA_VERSION.tgz"; \
    echo "$REA_SHA256  rea.tgz" | sha256sum -c -; \
    tar -xzf rea.tgz; \
    mkdir -p /opt/rea; \
    # 只搬运行需要的东西。tarball 里的 `licenses/`（1.1MB）是第三方
    # 许可证汇编，MIT 分发不要求我们打包它；`native/windows` 用不上。
    cp -r package/dist package/scripts package/package.json package/LICENSE /opt/rea/; \
    cd /opt/rea; \
    # --omit=optional 省掉 frida 113MB；--omit=dev 省掉测试依赖；
    # --ignore-scripts 不跑 postinstall（它会去 GitHub Releases 抓东西，
    # 构建期多一个联网点、也多一处不可控）。
    npm install --omit=optional --omit=dev --ignore-scripts --no-audit --no-fund; \
    # 删掉 REA 自带的 agent SDK：它是给「把 REA 当 agent 运行时」用的，
    # 我们只调 CLI，16MB 纯属白占。
    rm -rf node_modules/@anthropic-ai; \
    # 删 node 自带的 npm/corepack：我们只用 `node script.mjs` 跑 REA，
    # 装依赖那一步已经做完了。省 269MB。
    rm -rf /usr/local/lib/node_modules /usr/local/include/node \
           /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
           /usr/local/bin/node-gyp 2>/dev/null || true; \
    rm -rf /tmp/package /tmp/rea.tgz; \
    # ★ 构建期自检：跑一条**纯静态、零外部依赖**的命令。
    #   为什么挑 inspect-elf-notes：它只读 ELF 的 note 段，不依赖
    #   Ghidra / pwntools / tshark 任何一个。
    # ⚠️ 不用 `rea doctor` 自检：它因「环境不完备」返回非零码，
    #   而构建期要验证的是「能跑」，不是「环境完备」。
    node /opt/rea/scripts/rea.mjs inspect-elf-notes /bin/ls --json > /tmp/rea_smoke.json; \
    grep -q 'evidence_id' /tmp/rea_smoke.json; \
    rm -f /tmp/rea_smoke.json; \
    # 版本自检：证明装的是钉死那一版。
    node /opt/rea/scripts/rea.mjs --version; \
    # 最后量一次体积，写进构建日志 —— 下次有人怀疑"是不是它把镜像撑大了"
    # 时，答案在日志里，不用重新推理。
    du -sh /opt/rea /usr/local/bin/node

# 一个小包装，让 `rea` 这个词在容器里直接可用（run_shell 里手工调试时方便；
# 内核走的是 `app/kernel/rea.py` 里的绝对路径，不依赖这个 PATH 项）。
RUN printf '#!/bin/sh\nexec /usr/local/bin/node /opt/rea/scripts/rea.mjs "$@"\n' \
      > /usr/local/bin/rea && chmod +x /usr/local/bin/rea && rea --version
